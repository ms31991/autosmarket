{
  "rewrites": [
    {
      "source": "/sitemap-vehicles.xml",
      "destination": "https://api.autosmarket.me/api/sitemap.xml"
    },
    {
      "source": "/sitemap-taxonomy.xml",
      "destination": "https://api.autosmarket.me/api/sitemap-taxonomy.xml"
    },
    {
      "source": "/((?!ads\\.txt|robots\\.txt|sitemap\\.xml|sitemap-static\\.xml|sitemap-vehicles\\.xml|sitemap-taxonomy\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
